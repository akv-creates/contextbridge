# Environment variables for ContextBridge backend — copy to .env and fill in values.
#
# NOTE: DATABASE_URL and OLLAMA_BASE_URL below assume you're running
# `npm start` directly on this machine (Postgres + Ollama also on localhost).
# If you're using `docker compose up` instead, docker-compose.yml overrides
# both to the correct container-network values automatically — you don't
# need to change anything here for that path.
PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/contextbridge
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
API_KEY=your_static_api_key_here
GROQ_API_KEY=your_key_here

# Local privacy/cost gate (engine/local-gate.js) — runs before Groq structuring.
# script (default): deterministic regex/heuristic redaction only. Near-instant,
#   no local model dependency. Catches email/phone/API keys/SSN/street
#   addresses/credit cards (Luhn-checked) and self-introduced names
#   ("my name is X", "I'm X"). Lower recall than 'llm' on names without a
#   self-intro, unusual address formats, and health/financial context.
# llm: additionally runs a local Ollama model for PII regex can't reliably
#   catch. Slower (measured 15-20s on a base M1 with phi3) and requires
#   Ollama running. The OLLAMA_* vars below only apply in this mode.
PII_GATE_MODE=script
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# block (default, safe): refuse to call Groq if Ollama is unreachable.
# warn: proceed unredacted to Groq if Ollama is unreachable, just log a warning.
OLLAMA_FALLBACK_MODE=block
